# API
DATABASE_URL=postgresql://market:market@localhost:5442/market?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=market-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Next.js port. Override locally if 3000 is taken.
WEB_PORT=3000
# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
SHADOW_DATABASE_URL=postgresql://market:market@localhost:5442/market_shadow?schema=public
