{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "prebuild": "pnpm db:generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "test": "pnpm db:generate && vitest run --coverage",
    "test:integration": "pnpm db:generate && vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@market/shared": "workspace:*",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "jose": "^6.2.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "prisma": "7.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "unplugin-swc": "^1.5.7",
    "vitest": "^4.1.12"
  }
}
