generator client {
provider = "prisma-client"
output = "../src/generated/prisma"
}
datasource db {
provider = "postgresql"
}

enum Role {
USER
ADMIN
}
enum UserStatus {
ACTIVE
SUSPENDED
BANNED
}
enum ListingKind {
REQUEST
OFFER
}
enum ListingStatus {
DRAFT
OPEN
IN_PROGRESS
COMPLETED
CLOSED
REMOVED
}
enum PriceType {
FIXED
RANGE
NEGOTIABLE
}
enum BidStatus {
PENDING
SHORTLISTED
COUNTERED
ACCEPTED
REJECTED
WITHDRAWN
DECLINED
}
enum MessageType {
TEXT
IMAGE
FILE
VOICE
}
enum AgreementStatus {
ACTIVE
DELIVERED
COMPLETED
CANCELLED
DISPUTED
}
enum MilestoneStatus {
PENDING
IN_PROGRESS
DONE
}
enum UploadPurpose {
LISTING_IMAGE
LISTING_ATTACHMENT
BID_ATTACHMENT
MESSAGE_ATTACHMENT
DELIVERABLE
AVATAR
}
enum UploadStatus {
PENDING
READY
FAILED
}
enum NotificationType {
BID_RECEIVED
BID_UPDATED
BID_COUNTERED
BID_ACCEPTED
BID_REJECTED
MESSAGE_RECEIVED
DELIVERABLE_SUBMITTED
DELIVERABLE_ACCEPTED
REVISION_REQUESTED
AGREEMENT_COMPLETED
AGREEMENT_CANCELLED
REPORT_RESOLVED
REVIEW_RECEIVED
}
enum ReportTargetType {
LISTING
USER
MESSAGE
BID
AGREEMENT
}
enum ReportReason {
SPAM
FRAUD
INAPPROPRIATE
HARASSMENT
OTHER
}
enum ReportStatus {
OPEN
RESOLVED
DISMISSED
}
enum ReportResolution {
DISMISS
REMOVE_CONTENT
SUSPEND_USER
}
enum AgreementEventType {
CREATED
STATUS_CHANGED
MILESTONE_CREATED
MILESTONE_UPDATED
DELIVERABLE_SUBMITTED
DELIVERABLE_ACCEPTED
REVISION_REQUESTED
CANCELLED
DISPUTED
COMPLETED
}

model User {
id String @id @default(cuid())
email String @unique
passwordHash String
role Role @default(USER)
status UserStatus @default(ACTIVE)
suspendedReason String?
suspendedAt DateTime?
displayName String
avatarKey String?
bio String?
location String?
isBusiness Boolean @default(false)
companyName String?
ratingAvg Float @default(0)
ratingCount Int @default(0)
completedCount Int @default(0)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
refreshTokens RefreshToken[]
listings Listing[]
bids Bid[]
bidRevisions BidRevision[] @relation("BidRevisionAuthor")
sentMessages Message[]
submittedDeliverables Deliverable[] @relation("DeliverableSubmitter")
participants ConversationParticipant[]
buyerAgreements Agreement[] @relation("Buyer")
providerAgreements Agreement[] @relation("Provider")
cancelledAgreements Agreement[] @relation("AgreementCanceller")
agreementEvents AgreementEvent[] @relation("AgreementEventActor")
reviewsWritten Review[] @relation("ReviewAuthor")
reviewsReceived Review[] @relation("ReviewTarget")
notifications Notification[]
uploads Upload[]
reports Report[]
resolvedReports Report[] @relation("ReportResolver")
auditLogs AuditLog[]
@@index([status])
}
model RefreshToken {
id String @id @default(cuid())
tokenHash String @unique
familyId String
userId String
user User @relation(fields:[userId],references:[id],onDelete:Cascade)
expiresAt DateTime
revokedAt DateTime?
replacedById String?
replacedBy RefreshToken? @relation("TokenReplacement",fields:[replacedById],references:[id])
replaces RefreshToken[] @relation("TokenReplacement")
createdAt DateTime @default(now())
@@index([userId,familyId])
}
model Category {
id String @id @default(cuid())
name String
slug String @unique
description String?
parentId String?
parent Category? @relation("CategoryTree",fields:[parentId],references:[id],onDelete:Restrict)
children Category[] @relation("CategoryTree")
listings Listing[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([parentId])
}
model Listing {
id String @id @default(cuid())
ownerId String
owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
categoryId String
category Category @relation(fields:[categoryId],references:[id],onDelete:Restrict)
kind ListingKind
status ListingStatus @default(DRAFT)
removedReason String?
removedAt DateTime?
previousStatus ListingStatus?
title String
description String
priceType PriceType
priceMinCents Int?
priceMaxCents Int?
currency String @default("USD")
deliveryDays Int?
location String?
tags String[] @default([])
expiresAt DateTime?
images ListingImage[]
attachments ListingAttachment[]
bids Bid[]
agreements Agreement[]
conversations Conversation[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([status,createdAt])
@@index([ownerId,status])
@@index([categoryId,status])
@@index([priceMinCents])
@@index([status,kind,location])
@@index([status,priceMinCents])
@@index([status,expiresAt])
}
model Upload {
id String @id @default(cuid())
uploaderId String
uploader User @relation(fields:[uploaderId],references:[id],onDelete:Restrict)
purpose UploadPurpose
status UploadStatus @default(PENDING)
key String @unique
fileName String
mimeType String
sizeBytes Int
createdAt DateTime @default(now())
completedAt DateTime?
listingImages ListingImage[]
listingAttachments ListingAttachment[]
bidAttachments BidAttachment[]
messageAttachments MessageAttachment[]
deliverableAttachments DeliverableAttachment[]
@@index([uploaderId,status])
}
model ListingImage {
id String @id @default(cuid())
listingId String
listing Listing @relation(fields:[listingId],references:[id],onDelete:Cascade)
uploadId String @unique
upload Upload @relation(fields:[uploadId],references:[id],onDelete:Restrict)
position Int @default(0)
@@unique([listingId,uploadId])
}
model ListingAttachment {
id String @id @default(cuid())
listingId String
listing Listing @relation(fields:[listingId],references:[id],onDelete:Cascade)
uploadId String @unique
upload Upload @relation(fields:[uploadId],references:[id],onDelete:Restrict)
@@unique([listingId,uploadId])
}
model Bid {
id String @id @default(cuid())
listingId String
listing Listing @relation(fields:[listingId],references:[id],onDelete:Restrict)
bidderId String
bidder User @relation(fields:[bidderId],references:[id],onDelete:Restrict)
amountCents Int
currency String
deliveryDays Int
message String
status BidStatus @default(PENDING)
rejectReason String?
lastCounterById String?
revisions BidRevision[]
attachments BidAttachment[]
agreement Agreement?
conversations Conversation[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([listingId,status])
@@index([bidderId,status])
}
model BidRevision {
  id           String   @id @default(cuid())
  seq          Int      @default(autoincrement())
  bidId        String
  bid          Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation("BidRevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  amountCents  Int
  deliveryDays Int
  message      String
  createdAt    DateTime @default(now())

  @@index([bidId, createdAt])
  @@index([bidId, seq])
}
model BidAttachment {
id String @id @default(cuid())
bidId String
bid Bid @relation(fields:[bidId],references:[id],onDelete:Cascade)
uploadId String
upload Upload @relation(fields:[uploadId],references:[id],onDelete:Restrict)
@@unique([bidId,uploadId])
}
model Conversation {
id String @id @default(cuid())
participantPairKey String
listingDedupKey String
listingId String?
listing Listing? @relation(fields:[listingId],references:[id],onDelete:Restrict)
bidId String?
bid Bid? @relation(fields:[bidId],references:[id],onDelete:Restrict)
agreementId String? @unique
agreement Agreement? @relation(fields:[agreementId],references:[id],onDelete:Restrict)
participants ConversationParticipant[]
messages Message[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
lastMessageAt DateTime
@@index([listingId])
@@index([bidId])
@@unique([participantPairKey,listingDedupKey])
@@index([lastMessageAt])
}
model ConversationParticipant {
conversationId String
userId String
conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
user User @relation(fields:[userId],references:[id],onDelete:Cascade)
lastReadMessageId String?
joinedAt DateTime @default(now())
@@id([conversationId,userId])
@@index([userId])
}
model Message {
id String @id @default(cuid())
conversationId String
conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
senderId String
sender User @relation(fields:[senderId],references:[id],onDelete:Restrict)
type MessageType
body String?
voiceDurationSec Int?
attachments MessageAttachment[]
createdAt DateTime @default(now())
@@index([conversationId,createdAt])
}
model MessageAttachment {
id String @id @default(cuid())
messageId String
message Message @relation(fields:[messageId],references:[id],onDelete:Cascade)
uploadId String @unique
upload Upload @relation(fields:[uploadId],references:[id],onDelete:Restrict)
@@unique([messageId,uploadId])
}
model Agreement {
id String @id @default(cuid())
listingId String
listing Listing @relation(fields:[listingId],references:[id],onDelete:Restrict)
bidId String @unique
bid Bid @relation(fields:[bidId],references:[id],onDelete:Restrict)
buyerId String
buyer User @relation("Buyer",fields:[buyerId],references:[id],onDelete:Restrict)
providerId String
provider User @relation("Provider",fields:[providerId],references:[id],onDelete:Restrict)
conversation Conversation?
status AgreementStatus @default(ACTIVE)
completedAt DateTime?
cancelledAt DateTime?
cancelledById String?
cancelledBy User? @relation("AgreementCanceller",fields:[cancelledById],references:[id],onDelete:Restrict)
cancelReason String?
disputeReason String?
statusChangedAt DateTime @default(now())
buyerConfirmedAt DateTime?
providerConfirmedAt DateTime?
milestones Milestone[]
deliverables Deliverable[]
events AgreementEvent[]
reviews Review[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([buyerId,status])
@@index([providerId,status])
}
model Milestone {
id String @id @default(cuid())
agreementId String
agreement Agreement @relation(fields:[agreementId],references:[id],onDelete:Cascade)
title String
amountCents Int?
dueDate DateTime?
status MilestoneStatus @default(PENDING)
position Int @default(0)
createdAt DateTime @default(now())
@@index([agreementId])
}
model Deliverable {
id String @id @default(cuid())
agreementId String
agreement Agreement @relation(fields:[agreementId],references:[id],onDelete:Cascade)
note String
submittedById String
submittedBy User @relation("DeliverableSubmitter",fields:[submittedById],references:[id],onDelete:Restrict)
acceptedAt DateTime?
revisionNote String?
attachments DeliverableAttachment[]
createdAt DateTime @default(now())
@@index([agreementId])
}
model DeliverableAttachment {
id String @id @default(cuid())
deliverableId String
deliverable Deliverable @relation(fields:[deliverableId],references:[id],onDelete:Cascade)
uploadId String @unique
upload Upload @relation(fields:[uploadId],references:[id],onDelete:Restrict)
}
model AgreementEvent {
id String @id @default(cuid())
agreementId String
agreement Agreement @relation(fields:[agreementId],references:[id],onDelete:Cascade)
actorId String?
actor User? @relation("AgreementEventActor",fields:[actorId],references:[id],onDelete:SetNull)
type AgreementEventType
data Json?
createdAt DateTime @default(now())
@@index([agreementId,createdAt])
}
model Review {
id String @id @default(cuid())
agreementId String
agreement Agreement @relation(fields:[agreementId],references:[id],onDelete:Cascade)
authorId String
author User @relation("ReviewAuthor",fields:[authorId],references:[id],onDelete:Restrict)
targetId String
target User @relation("ReviewTarget",fields:[targetId],references:[id],onDelete:Restrict)
rating Int
comment String?
createdAt DateTime @default(now())
@@unique([agreementId,authorId])
@@index([targetId,createdAt])
}
model Notification {
id String @id @default(cuid())
userId String
user User @relation(fields:[userId],references:[id],onDelete:Cascade)
type NotificationType
title String
body String
link String?
data Json?
conversationId String?
readAt DateTime?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([userId,readAt,createdAt])
@@index([userId,conversationId])
}
model Report {
id String @id @default(cuid())
reporterId String
reporter User @relation(fields:[reporterId],references:[id],onDelete:Restrict)
targetType ReportTargetType
targetId String
reason ReportReason
details String?
status ReportStatus @default(OPEN)
resolutionNote String?
resolution ReportResolution?
resolvedById String?
resolvedBy User? @relation("ReportResolver",fields:[resolvedById],references:[id],onDelete:Restrict)
createdAt DateTime @default(now())
resolvedAt DateTime?
@@index([status,createdAt])
@@index([targetType,targetId])
}
model AuditLog {
id String @id @default(cuid())
actorId String
actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
action String
targetType String
targetId String?
data Json?
createdAt DateTime @default(now())
@@index([actorId,createdAt])
}
